{
  "CivitaiApi": {
    "ApiKey": "your-api-key"
  },
  "CivitaiDownloads": {
    "Images": {
      "BaseDirectory": "C:\\Downloads\\Images",
      "PathPattern": "{Username}/{Id}.{Extension}",
      "OverwriteExisting": false
    },
    "Models": {
      "BaseDirectory": "C:\\Downloads\\Models",
      "PathPattern": "{ModelType}/{ModelName}/{FileName}",
      "OverwriteExisting": true,
      "VerifyHash": true,
      "HashAlgorithm": "Sha256"
    }
  }
}
